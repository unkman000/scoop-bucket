{
    "version": "0.12.1",
    "description": "Foundry Local CLI - portable (extracted from msix)",
    "homepage": "https://github.com/microsoft/foundry-local",
    "license": "Proprietary",
    "url": "https://github.com/microsoft/foundry-local/releases/download/cli-preview-0.12.1/foundry-0.12.1-win-x64.msix",
    "hash": "083c97f80462f40833919f2c63077b3603e058208960784388127cc4a7e7a1da",
    "installer": {
        "script": [
            "$msix = (Get-ChildItem \"$dir\\*.msix\" | Select-Object -First 1).FullName",
            "Expand-Archive -Path $msix -DestinationPath \"$dir\\foundry\" -Force",
            "Get-ChildItem \"$dir\\foundry\\*\" -File | ForEach-Object { Copy-Item $_.FullName -Destination $dir -Force }",
            "Remove-Item \"$dir\\foundry\" -Recurse -Force",
            "Remove-Item $msix -Force"
        ]
    },
    "bin": "foundry.exe",
    "checkver": {
        "url": "https://api.github.com/repos/microsoft/foundry-local/releases",
        "jsonpath": "$[?(@.tag_name =~ /cli-preview-([\\d.]+)/)].tag_name",
        "regex": "cli-preview-([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/microsoft/foundry-local/releases/download/cli-preview-$version/foundry-$version-win-x64.msix",
        "hash": {
            "url": "https://api.github.com/repos/microsoft/foundry-local/releases/tags/cli-preview-$version",
            "jsonpath": "$.assets[?(@.name =~ /foundry-$version-win-x64\\.msix/)].digest",
            "regex": "sha256:([a-f0-9]{64})"
        }
    }
}
